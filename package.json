{
  "name": "nockdock",
  "productName": "Nockdock",
  "version": "0.6.0",
  "description": "Touch dashboard for the small screen under your monitors: projects, Claude Code, deploys and desk controls, with a pixel-art mascot.",
  "author": "yvr1x02",
  "license": "MIT",
  "homepage": "https://github.com/yvr1x02/nockdock#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yvr1x02/nockdock.git"
  },
  "bugs": {
    "url": "https://github.com/yvr1x02/nockdock/issues"
  },
  "keywords": [
    "electron",
    "dashboard",
    "stream-deck",
    "touchscreen",
    "windows",
    "claude-code",
    "developer-tools",
    "pixel-art"
  ],
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0"
}
